{"id": "w24", "num": 24, "title": "Verbos esenciales", "rows": [{"cat": "NIVEL A1 · PRINCIPIANTE"}, {"es": "ser, estar", "img": null, "level": "A1", "pos": "verb", "l": {"english": {"word": "be", "forms": "was/were, been", "pron": "bii", "ipa": "/biː/", "ex": "I want to be a teacher.", "ex_es": "Quiero ser profesor."}}}, {"es": "llegar a ser, volverse", "img": null, "level": "A1", "pos": "verb", "l": {"english": {"word": "become", "forms": "became, become", "pron": "bikám", "ipa": "/bɪˈkʌm/", "ex": "She wants to become a doctor.", "ex_es": "Quiere llegar a ser médica."}}}, {"es": "traer", "img": null, "level": "A1", "pos": "verb", "l": {"english": {"word": "bring", "forms": "brought, brought", "pron": "bring", "ipa": "/brɪŋ/", "ex": "Can you bring some drinks tonight?", "ex_es": "¿Puedes traer algo de beber esta noche?"}}}, {"es": "poder", "img": null, "level": "A1", "pos": "modal verb", "l": {"english": {"word": "can", "forms": "could", "pron": "kan", "ipa": "/kæn/", "ex": "I can swim very well.", "ex_es": "Sé nadar muy bien."}}}, {"es": "no poder", "img": null, "level": "A1", "pos": "modal verb", "l": {"english": {"word": "cannot", "forms": "could not", "pron": "kánot", "ipa": "/ˈkænɒt/", "ex": "I cannot find my keys.", "ex_es": "No puedo encontrar mis llaves."}}}, {"es": "venir", "img": null, "level": "A1", "pos": "verb", "l": {"english": {"word": "come", "forms": "came, come", "pron": "kam", "ipa": "/kʌm/", "ex": "Can you come to my party?", "ex_es": "¿Puedes venir a mi fiesta?"}}}, {"es": "podría, podía", "img": null, "level": "A1", "pos": "modal verb", "l": {"english": {"word": "could", "forms": "", "pron": "kud", "ipa": "/kʊd/", "ex": "I could read when I was four.", "ex_es": "Sabía leer cuando tenía cuatro años."}}}, {"es": "hacer", "img": null, "level": "A1", "pos": "verb", "l": {"english": {"word": "do", "forms": "did, done", "pron": "duu", "ipa": "/duː/", "ex": "I do my homework after dinner.", "ex_es": "Hago los deberes después de cenar."}}}, {"es": "encontrar", "img": "img/om_1F50D.png", "level": "A1", "pos": "verb", "l": {"english": {"word": "find", "forms": "found, found", "pron": "fáind", "ipa": "/faɪnd/", "ex": "I can't find my phone anywhere.", "ex_es": "No encuentro el móvil por ningún sitio."}}}, {"es": "conseguir, obtener, llegar", "img": null, "level": "A1", "pos": "verb", "l": {"english": {"word": "get", "forms": "got, got", "pron": "guet", "ipa": "/ɡet/", "ex": "Where did you get that jacket?", "ex_es": "¿Dónde conseguiste esa chaqueta?"}}}, {"es": "dar", "img": null, "level": "A1", "pos": "verb", "l": {"english": {"word": "give", "forms": "gave, given", "pron": "guiv", "ipa": "/ɡɪv/", "ex": "Please give me your address.", "ex_es": "Por favor, dame tu dirección."}}}, {"es": "ir", "img": null, "level": "A1", "pos": "verb", "l": {"english": {"word": "go", "forms": "went, gone", "pron": "góu", "ipa": "/ɡəʊ/", "ex": "We go to the beach every summer.", "ex_es": "Vamos a la playa cada verano."}}}, {"es": "tener, haber", "img": null, "level": "A1", "pos": "verb", "l": {"english": {"word": "have", "forms": "had, had", "pron": "jav", "ipa": "/hæv/", "ex": "I have two brothers and a sister.", "ex_es": "Tengo dos hermanos y una hermana."}}}, {"es": "tener que", "img": null, "level": "A1", "pos": "modal verb", "l": {"english": {"word": "have to", "forms": "had to, had to", "pron": "jáv tu", "ipa": "/ˈhæv tə/", "ex": "I have to get up early tomorrow.", "ex_es": "Mañana tengo que levantarme temprano."}}}, {"es": "ayudar", "img": "img/om_E083.png", "level": "A1", "pos": "verb", "l": {"english": {"word": "help", "forms": "helped, helped", "pron": "jelp", "ipa": "/help/", "ex": "Can you help me with this box?", "ex_es": "¿Me ayudas con esta caja?"}}}, {"es": "guardar, mantener, seguir", "img": null, "level": "A1", "pos": "verb", "l": {"english": {"word": "keep", "forms": "kept, kept", "pron": "kiip", "ipa": "/kiːp/", "ex": "Keep the receipt in case.", "ex_es": "Guarda el recibo por si acaso."}}}, {"es": "dejar, permitir