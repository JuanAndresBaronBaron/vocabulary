": "/dəvwaʁ/", "ex": "Je dois partir tôt demain matin.", "ex_es": "Tengo que salir temprano mañana."}, "dansk": {"word": "være nødt til", "forms": "", "pron": "vére nöt til", "ipa": "/ˈvɛːɐ ˈnøˀd te/", "ex": "Jeg er nødt til at gå nu.", "ex_es": "Tengo que irme ya."}}}, {"es": "ayudar", "img": "img/om_E083.png", "level": "A1", "pos": "verb", "l": {"english": {"word": "help", "forms": "helped, helped", "pron": "jelp", "ipa": "/help/", "ex": "Can you help me with this box?", "ex_es": "¿Me ayudas con esta caja?"}, "français": {"word": "aider", "forms": "j'aide, aidé", "pron": "edé", "ipa": "/ede/", "ex": "Tu peux m'aider à porter ça ?", "ex_es": "¿Me ayudas a llevar esto?"}, "dansk": {"word": "at hjælpe", "forms": "hjælper, hjalp, hjulpet", "pron": "iélpe", "ipa": "/ˈjɛlbə/", "ex": "Kan du hjælpe mig med lektierne?", "ex_es": "¿Me puedes ayudar con los deberes?"}}}, {"es": "guardar, mantener, seguir", "img": null, "level": "A1", "pos": "verb", "l": {"english": {"word": "keep", "forms": "kept, kept", "pron": "kiip", "ipa": "/kiːp/", "ex": "Keep the receipt in case.", "ex_es": "Guarda el recibo por si acaso."}, "français": {"word": "garder", "forms": "je garde, gardé", "pron": "gardé", "ipa": "/ɡaʁde/", "ex": "Gardez la monnaie, monsieur.", "ex_es": "Quédese con el cambio, señor."}, "dansk": {"word": "at beholde", "forms": "beholder, beholdt, beholdt", "pron": "behóle", "ipa": "/beˈhʌlˀə/", "ex": "Du må gerne beholde bogen.", "ex_es": "Puedes quedarte con el libro."}}}, {"es": "dejar, permitir", "img": null, "level": "A1", "pos": "verb", "l": {"english": {"word": "let", "forms": "let, let", "pron": "let", "ipa": "/let/", "ex": "My parents let me stay out late.", "ex_es": "Mis padres me dejan volver tarde."}, "français": {"word": "laisser", "forms": "je laisse, laissé", "pron": "lesé", "ipa": "/lese/", "ex": "Laisse-moi parler, s'il te plaît.", "ex_es": "Déjame hablar, por favor."}, "dansk": {"word": "at lade", "forms": "lader, lod, ladet", "pron": "láde", "ipa": "/ˈlæːðə/", "ex": "Mine forældre lod mig gå til festen.", "ex_es": "Mis padres me dejaron ir a la fiesta."}}}, {"es": "hacer, fabricar", "img": null, "level": "A1", "pos": "verb", "l": {"english": {"word": "make", "forms": "made, made", "pron": "méik", "ipa": "/meɪk/", "ex": "Let's make a cake for her birthday.", "ex_es": "Hagamos una tarta para su cumpleaños."}, "français": {"word": "faire", "forms": "je fais, fait", "pron": "fer", "ipa": "/fɛʁ/", "ex": "Je fais un gâteau pour son anniversaire.", "ex_es": "Hago un pastel para su cumpleaños."}, "dansk": {"word": "at lave", "forms": "laver, lavede, lavet", "pron": "láve", "ipa": "/ˈlæːvə/", "ex": "Jeg laver mad i aften.", "ex_es": "Esta noche hago la cena."}}}, {"es": "deber, tener que", "img": null, "level": "A1", "pos": "modal verb", "l": {"english": {"word": "must", "forms": "", "pron": "mast", "ipa": "/mʌst/", "ex": "You must wear a seatbelt.", "ex_es": "Debes llevar el cinturón de seguridad."}, "français": {"word": "devoir", "forms": "je dois, dû", "pron": "devuár", "ipa": "/dəvwaʁ/", "ex": "Vous devez attacher votre ceinture.", "ex_es": "Debe abrocharse el cinturón."}, "dansk": {"word": "må", "forms": "", "pron": "mo", "ipa": "/ˈmɔˀ/", "ex": "Jeg må gå nu.", "ex_es": "Tengo que irme ya."}}}, {"es": "necesitar", "img": null, "level": "A1", "pos": "verb", "l": {"english": {"word": "need", "forms": "needed, needed", "pron": "niid", "ipa": "/niːd/", "ex": "I need a new pair of shoes.", "ex_es": "Necesito un par de zapatos nuevos."}, "français": {"word": "avoir besoin de", "forms": "j'ai besoin de, eu besoin de", "pron": "avuár besuán de", "ipa": "/avwaʁ bəzwɛ̃ də/", "ex": "J'ai besoin de ton aide.", "ex_es": "Necesito tu ayuda."}, "dansk": {"word": "at behøve", "forms": "behøver, behøvede, behøvet", "pron": "behöve", "ipa": "/beˈhøˀvə/", "ex": "Du behøver ikke at komme.", "ex_es": "No necesitas venir."}}}, {"es": "poner", "img": null, "level": "A1", "pos": "verb", "l": {"english": {"word": "put", "forms": "put, put", "pron": "put", "ipa": "/pʊt/", "ex": "Put the milk in the fridge.", "ex_es": "Pon la leche en la nevera."}, "français": {"word": "mettre", "forms": "je mets, mis", "pron": "metr", "ipa": "/mɛtʁ/", "ex": "Mets les assiettes sur la table.", "ex_es": "Pon los platos en la mesa."}, "dansk": {"word": "at sætte", "forms": "sætter, satte, sat", "pron": "séte", "ipa": "/ˈsɛdə/", "ex": "Sæt kopperne på bordet, tak.", "ex_es": "Pon las tazas en la mesa, por favor."}}}, {"es": "decir", "img": null, "level": "A1", "pos": "verb", "l": {"english": {"word": "say", "forms": "said, said", "pron": "séi", "ipa": "/seɪ/", "ex": "What did she say to you?", "ex_es": "¿Qué te dijo?"}, "français": {"word": "dire", "forms": "je dis, dit", "pron": "dir", "ipa": "/diʁ/", "ex": "Qu'est-ce que tu as dit ?", "ex_es": "¿Qué has dicho?"}, "dansk": {"word": "at sige", "forms": "siger, sagde, sagt", "pron": "síe", "ipa": "/ˈsiːə/", "ex": "Hvad sagde du til ham?", "ex_es": "¿Qué le dijiste?"}}}, {"es": "deber (debería)", "img": null, "level": "A1", "pos": "modal verb", "l": {"english": {"word": "should", "forms": "", "pron": "shud", "ipa": "/ʃʊd/", "ex": "You should see a doctor.", "ex_es": "Deberías ir al médico."}, "français": {"word": "devoir", "forms": "je devrais, dû", "pron": "devuár", "ipa": "/dəvwaʁ/", "ex": "Tu devrais aller chez le médecin.", "ex_es": "Deberías ir al médico."}, "dansk": {"word": "bør", "forms": "", "pron": "bör", "ipa": "/ˈbœɐ̯/", "ex": "Du bør gå til lægen.", "ex_es": "Deberías ir al médico."}}}, {"es": "empezar, comenzar", "img": null, "level": "A1", "pos": "verb", "l": {"english": {"word": "start", "forms": "started, started", "pron": "staat", "ipa": "/stɑːt/", "ex": "The film starts at eight.", "ex_es": "La película empieza a las ocho."}, "français": {"word": "commencer", "forms": "je commence, commencé", "pron": "komansé", "ipa": "/kɔmɑ̃se/", "ex": "Le film commence à huit heures.", "ex_es": "La película empieza a las ocho."}, "dansk": {"word": "at starte", "forms": "starter, startede, startet", "pron": "stárte", "ipa": "/ˈsdɑːdə/", "ex": "Filmen starter klokken otte.", "ex_es": "La película empieza a las ocho."}}}, {"es": "tomar, llevar", "img": null, "level": "A1", "pos": "verb", "l": {"english": {"word": "take", "forms": "took, taken", "pron": "téik", "ipa": "/teɪk/", "ex": "Take an umbrella with you.", "ex_es": "Llévate un paraguas."}, "français": {"word": "prendre", "forms": "je prends, pris", "pron": "prandr", "ipa": "/pʁɑ̃dʁ/", "ex": "Je prends le train tous les jours.", "ex_es": "Tomo el tren todos los días."}, "dansk": {"word": "at tage", "forms": "tager, tog, taget", "pron": "te", "ipa": "/ˈtæˀ/", "ex": "Vi tager bussen til byen.", "ex_es": "Cogemos el autobús al centro."}}}, {"es": "intentar, probar", "img": null, "level": "A1", "pos": "verb", "l": {"english": {"word": "try", "forms": "tried, tried", "pron": "trái", "ipa": "/traɪ/", "ex": "Try this cake, it's delicious.", "ex_es": "Prueba esta tarta, está riquísima."}, "français": {"word": "essayer", "forms": "j'essaie, essayé", "pron": "eseié", "ipa": "/eseje/", "ex": "J'essaie d'apprendre le français.", "ex_es": "Intento aprender francés."}, "dansk": {"word": "at prøve", "forms": "prøver, prøvede, prøvet", "pron": "pröve", "ipa": "/ˈpʁœːvə/", "ex": "Vil du prøve kagen?", "ex_es": "¿Quieres probar la tarta?"}}}, {"es": "usar", "img": null, "level": "A1", "pos": "verb", "l": {"english": {"word": "use", "forms": "used, used", "pron": "iúuz", "ipa": "/juːz/", "ex": "Can I use your phone?", "ex_es": "¿Puedo usar tu teléfono?"}, "français": {"word": "utiliser", "forms": "j'utilise, utilisé", "pron": "ütilisé", "ipa": "/ytilize/", "ex": "J'utilise mon ordinateur pour travailler.", "ex_es": "Uso mi ordenador para trabajar."}, "dansk": {"word": "at bruge", "forms": "bruger, brugte, brugt", "pron": "brúe", "ipa": "/ˈbʁuːə/", "ex": "Må jeg bruge din telefon?", "ex_es": "¿Puedo usar tu teléfono?"}}}, {"es": "querer", "img": null, "level": "A1", "pos": "verb", "l": {"english": {"word"