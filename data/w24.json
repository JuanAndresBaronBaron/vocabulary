{"id": "w24", "num": 24, "title": "Verbos esenciales", "rows": [{"cat": "NIVEL A1 · PRINCIPIANTE"}, {"es": "ser, estar", "img": null, "level": "A1", "pos": "verb", "l": {"english": {"word": "be", "forms": "was/were, been", "pron": "bii", "ipa": "/biː/", "ex": "I want to be a teacher.", "ex_es": "Quiero ser profesor."}, "français": {"word": "être", "forms": "je suis, été", "pron": "etr", "ipa": "/ɛtʁ/", "ex": "Je suis très content de te voir.", "ex_es": "Estoy muy contento de verte."}, "dansk": {"word": "at være", "forms": "er, var, været", "pron": "vére", "ipa": "/ˈvɛːɐ/", "ex": "Jeg vil gerne være læge.", "ex_es": "Me gustaría ser médico."}}}, {"es": "llegar a ser, volverse", "img": null, "level": "A1", "pos": "verb", "l": {"english": {"word": "become", "forms": "became, become", "pron": "bikám", "ipa": "/bɪˈkʌm/", "ex": "She wants to become a doctor.", "ex_es": "Quiere llegar a ser médica."}, "français": {"word": "devenir", "forms": "je deviens, devenu", "pron": "devenír", "ipa": "/dəvniʁ/", "ex": "Elle veut devenir médecin.", "ex_es": "Quiere llegar a ser médica."}, "dansk": {"word": "at blive", "forms": "bliver, blev, blevet", "pron": "blíe", "ipa": "/ˈbliːə/", "ex": "Han vil gerne blive pilot.", "ex_es": "Él quiere llegar a ser piloto."}}}, {"es": "traer", "img": null, "level": "A1", "pos": "verb", "l": {"english": {"word": "bring", "forms": "brought, brought", "pron": "bring", "ipa": "/brɪŋ/", "ex": "Can you bring some drinks tonight?", "ex_es": "¿Puedes traer algo de beber esta noche?"}, "français": {"word": "apporter", "forms": "j'apporte, apporté", "pron": "aporté", "ipa": "/apɔʁte/", "ex": "N'oublie pas d'apporter ton maillot de bain.", "ex_es": "No olvides traer tu bañador."}, "dansk": {"word": "at bringe", "forms": "bringer, bragte, bragt", "pron": "bréngue", "ipa": "/ˈbʁɛŋə/", "ex": "Tjeneren bragte os et glas vand.", "ex_es": "El camarero nos trajo un vaso de agua."}}}, {"es": "poder", "img": null, "level": "A1", "pos": "modal verb", "l": {"english": {