"A1", "pos": "verb", "l": {"english": {"word": "repeat", "forms": "repeated, repeated", "pron": "ripíit", "ipa": "/rɪˈpiːt/", "ex": "Could you repeat that, please?", "ex_es": "¿Podría repetir eso, por favor?"}, "français": {"word": "répéter", "forms": "je répète, répété", "pron": "repeté", "ipa": "/ʁepete/", "ex": "Pouvez-vous répéter la question ?", "ex_es": "¿Puede repetir la pregunta?"}, "dansk": {"word": "at gentage", "forms": "gentager, gentog, gentaget", "pron": "génte", "ipa": "/ˈgɛnˌtæˀ/", "ex": "Kan du gentage spørgsmålet, tak?", "ex_es": "¿Puedes repetir la pregunta, por favor?"}}}, {"es": "enviar, mandar", "img": "img/om_1F4E4.png", "level": "A1", "pos": "verb", "l": {"english": {"word": "send", "forms": "sent, sent", "pron": "send", "ipa": "/send/", "ex": "I'll send you an email later.", "ex_es": "Te mandaré un correo luego."}, "français": {"word": "envoyer", "forms": "j'envoie, envoyé", "pron": "anvuaié", "ipa": "/ɑ̃vwaje/", "ex": "J'envoie un message à Marie.", "ex_es": "Le envío un mensaje a Marie."}, "dansk": {"word": "at sende", "forms": "sender, sendte, sendt", "pron": "séne", "ipa": "/ˈsɛnə/", "ex": "Jeg sender dig en e-mail.", "ex_es": "Te envío un correo electrónico."}}}, {"es": "mostrar, enseñar", "img": null, "level": "A1", "pos": "verb", "l": {"english": {"word": "show", "forms": "showed, shown", "pron": "shóu", "ipa": "/ʃəʊ/", "ex": "Show me your photos from Spain.", "ex_es": "Enséñame tus fotos de España."}, "français": {"word": "montrer", "forms": "je montre, montré", "pron": "montré", "ipa": "/mɔ̃tʁe/", "ex": "Montre-moi tes photos de vacances.", "ex_es": "Enséñame tus fotos de vacaciones."}, "dansk": {"word": "at vise", "forms": "viser, viste, vist", "pron": "víse", "ipa": "/ˈviːsə/", "ex": "Kan du vise mig vejen?", "ex_es": "¿Puedes enseñarme el camino?"}}}, {"es": "hablar", "img": "img/om_1F5E3.png", "level": "A1", "pos": "verb", "l": {"english": {"word": "speak", "forms": "spoke, spoken", "pron": "spiik", "ipa": "/spiːk/", "ex": "Do you speak any other languages?", "ex_es": "¿Hablas algún otro idioma?"}, "français": {"word": "parler", "forms": "je parle, parlé", "pron": "parlé", "ipa": "/paʁle/", "ex": "Elle parle trois langues.", "ex_es": "Ella habla tres idiomas."}, "dansk": {"word": "at tale", "forms": "taler, talte, talt", "pron": "téle", "ipa": "/ˈtæːlə/", "ex": "Jeg taler lidt dansk.", "ex_es": "Hablo un poco de danés."}}}, {"es": "deletrear", "img": "img/om_1F524.png", "level": "A1", "pos": "verb", "l": {"english": {"word": "spell", "forms": "spelt, spelt", "pron": "spel", "ipa": "/spel/", "ex": "How do you spell your surname?", "ex_es": "¿Cómo se escribe tu apellido?"}, "français": {"word": "épeler", "forms": "j'épelle, épelé", "pron": "eplé", "ipa": "/eple/", "ex": "Pouvez-vous épeler votre nom ?", "ex_es": "¿Puede deletrear su nombre?"}, "dansk": {"word": "at stave", "forms": "staver, stavede, stavet", "pron": "stéve", "ipa": "/ˈsdæːvə/", "ex": "Hvordan staver man dit navn?", "ex_es": "¿Cómo se deletrea tu nombre?"}}}, {"es": "charlar, hablar", "img": "img/om_E246.png", "level": "A1", "pos": "verb", "l": {"english": {"word": "talk", "forms": "talked, talked", "pron": "took", "ipa": "/tɔːk/", "ex": "We talked for hours on the phone.", "ex_es": "Hablamos durante horas por teléfono."}, "français": {"word": "parler", "forms": "je parle, parlé", "pron": "parlé", "ipa": "/paʁle/", "ex": "Nous parlons souvent au téléphone.", "ex_es": "Hablamos a menudo por teléfono."}, "dansk": {"word": "at snakke", "forms": "snakker, snakkede, snakket", "pron": "snáke", "ipa": "/ˈsnagə/", "ex": "Vi snakkede sammen i flere timer.", "ex_es": "Hablamos durante varias horas."}}}, {"es": "enseñar", "img": "img/om_1F9D1-200D-1F3EB.png", "level": "A1", "pos": "verb", "l": {"english": {"word": "teach", "forms": "taught, taught", "pron": "tiich", "ipa": "/tiːtʃ/", "ex": "She teaches maths at a secondary school.", "ex_es": "Da clases de matemáticas en un instituto."}, "français": {"word": "enseigner", "forms": "j'enseigne, enseigné", "pron": "anseñé", "ipa": "/ɑ̃seɲe/", "ex": "Elle enseigne le français aux enfants.", "ex_es": "Ella enseña francés a los niños."}, "dansk": {"word": "at undervise", "forms": "underviser, underviste, undervist", "pron": "ónervise", "ipa": "/ˈɔnɐˌviˀsə/", "ex": "Hun underviser i matematik.", "ex_es": "Ella enseña matemáticas."}}}, {"es": "decir, contar", "img": null, "level": "A1", "pos": "verb", "l": {"english": {"word": "tell", "forms": "told, told", "pron": "tel", "ipa": "/tel/", "ex": "Tell me a story, Grandad.", "ex_es": "Cuéntame un cuento, abuelo."}, "français": {"word": "dire", "forms": "je dis, dit", "pron": "dir", "ipa": "/diʁ/", "ex": "Dis-moi toujours la vérité.", "ex_es": "Dime siempre la verdad."}, "dansk": {"word": "at fortælle", "forms": "fortæller, fortalte, fortalt", "pron": "fortéle", "ipa": "/fʌˈtɛlˀə/", "ex": "Fortæl mig en historie.", "ex_es": "Cuéntame una historia."}}}, {"es": "agradecer", "img": null, "level": "A1", "pos": "verb", "l": {"english": {"word": "thank", "forms": "thanked, thanked", "pron": "zank", "ipa": "/θæŋk/", "ex": "I want to thank you for your help.", "ex_es": "Quiero agradecerte tu ayuda."}, "français": {"word": "remercier", "forms": "je remercie, remercié", "pron": "remersié", "ipa": "/ʁəmɛʁsje/", "ex": "Je te remercie pour ton aide.", "ex_es": "Te agradezco tu ayuda."}, "dansk": {"word": "at takke", "forms": "takker, takkede, takket", "pron": "táke", "ipa": "/ˈtagə/", "ex": "Jeg vil gerne takke dig.", "ex_es": "Quiero darte las gracias."}}}, {"es": "escribir", "img": "img/om_270D.png", "level": "A1", "pos": "verb", "l": {"english": {"word": "write", "forms": "wrote, written", "pron": "ráit", "ipa": "/raɪt/", "ex": "I'm writing a letter to my friend.", "ex_es": "Estoy escribiendo una carta a mi amigo."}, "français": {"word": "écrire", "forms": "j'écris, écrit", "pron": "ekrír", "ipa": "/ekʁiʁ/", "ex": "J'écris une lettre à mon grand-père.", "ex_es": "Escribo una carta a mi abuelo."}, "dansk": {"word": "at skrive", "forms": "skriver, skrev, skrevet", "pron": "skríve", "ipa": "/ˈsgʁiːvə/", "ex": "Hun skriver et brev til sin mormor.", "ex_es": "Ella escribe una carta a su abuela."}}}, {"cat": "NIVEL A2 · BÁSICO"}, {"es": "discutir", "img": null, "level": "A2", "pos": "verb", "l": {"english": {"word": "argue", "forms": "argued, argued", "pron": "áaguiuu", "ipa": "/ˈɑːɡjuː/", "ex": "My parents often argue about money.", "ex_es": "Mis padres discuten a menudo por dinero."}, "français": {"word": "se disputer", "forms": "je me dispute, disputé", "pron": "se dispüté", "ipa": "/sə dispyte/", "ex": "Mes parents se disputent rarement.", "ex_es": "Mis padres rara vez discuten."}, "dansk": {"word": "at skændes", "forms": "skændes, skændtes, skændtes", "pron": "skénes", "ipa": "/ˈsgɛnəs/", "ex": "Børnene skændes hele tiden.", "ex_es": "Los niños discuten todo el rato."}}}, {"es": "charlar", "img": "img/om_1F4AC.png", "level": "A2", "pos": "verb", "l": {"english": {"word": "chat", "forms": "chatted, chatted", "pron": "chat", "ipa": "/tʃæt/", "ex": "We chatted over a cup of tea.", "ex_es": "Charlamos con una taza de té."}, "français": {"word": "bavarder", "forms": "je bavarde, bavardé", "pron": "bavardé", "ipa": "/bavaʁde/", "ex": "Nous bavardons au café.", "ex_es": "Charlamos en la cafetería."}, "dansk": {"word": "at sludre", "forms": "sludrer, sludrede, sludret", "pron": "slúdre", "ipa": "/ˈsluðʁɐ/", "ex": "Vi sad og sludrede over en kop kaffe.", "ex_es": "Estuvimos charlando con un café."}}}, {"es": "comunicarse", "img": null, "level": "A2", "pos": "verb", "l": {"english": {"word": "communicate", "forms": "communicated, communicated", "pron": "kemiúunikeit", "ipa": "/kəˈmjuːnɪkeɪt/", "ex": "We communicate mostly by email.", "ex_es": "Nos comunicamos sobre todo por correo electrónico."}, "français": {"word": "communiquer", "forms": "je communique, communiqué", "pron": "komünikué", "ipa": "/kɔmynike/", "ex": "Nous communiquons par e-mail.", "ex_es": "Nos comunicamos por correo electr