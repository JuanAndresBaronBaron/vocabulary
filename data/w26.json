{"id": "w26", "num": 26, "title": "Verbos de comunicación", "rows": [{"cat": "NIVEL A1 · PRINCIPIANTE"}, {"es": "estar de acuerdo", "img": "img/om_1F44D.png", "level": "A1", "pos": "verb", "l": {"english": {"word": "agree", "forms": "agreed, agreed", "pron": "egríi", "ipa": "/əˈɡriː/", "ex": "I agree with you completely.", "ex_es": "Estoy completamente de acuerdo contigo."}, "français": {"word": "être d'accord", "forms": "je suis d'accord, été", "pron": "etr dakór", "ipa": "/ɛtʁ dakɔʁ/", "ex": "Je suis d'accord avec toi.", "ex_es": "Estoy de acuerdo contigo."}, "dansk": {"word": "at være enig", "forms": "er enig, var enig, været enig", "pron": "vére éni", "ipa": "/ˈvɛːɐ ˈeːni/", "ex": "Jeg er helt enig med dig.", "ex_es": "Estoy totalmente de acuerdo contigo."}}}, {"es": "preguntar, pedir", "img": "img/om_2753.png", "level": "A1", "pos": "verb", "l": {"english": {"word": "ask", "forms": "asked, asked", "pron": "aask", "ipa": "/ɑːsk/", "ex": "Can I ask you a question?", "ex_es": "¿Puedo hacerte una pregunta?"}, "français": {"word": "demander", "forms": "je demande, demandé", "pron": "demandé", "ipa": "/dəmɑ̃de/", "ex": "Je demande le chemin à un passant.", "ex_es": "Le pregunto el camino a un transeúnte."}, "dansk": {"word": "at spørge", "forms": "spørger, spurgte, spurgt", "pron": "spöue", "ipa": "/ˈsbɶɐ̯wə/", "ex": "Må jeg spørge dig om noget?", "ex_es": "¿Puedo preguntarte algo?"}}}, {"es": "llamar", "img": "img/om_1F4DE.png", "level": "A1", "pos": "verb", "l": {"english": {"word": "call", "forms": "called, called", "pron": "kool", "ipa": "/kɔːl/", "ex": "I'll call you tomorrow evening.", "ex_es": "Te llamaré mañana por la tarde."}, "français": {"word": "appeler", "forms": "j'appelle, appelé", "pron": "aplé", "ipa": "/aple/", "ex": "J'appelle ma mère tous les soirs.", "ex_es": "Llamo a mi madre todas las noches."}, "dansk": {"word": "at ringe", "forms": "ringer, ringede, ringet", "pron": "rénge", "ipa": "/ˈʁeŋə/", "ex": "Jeg ringer til dig i morgen.", "ex_es": "Te