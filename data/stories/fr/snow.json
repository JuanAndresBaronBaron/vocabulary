   "img": "img/pj/conejo.png",
   "also": [
    "img/pj/zorro.png"
   ],
   "t": "Maintenant, le renard a chaud. Son ami le lapin vient jouer !",
   "es": "Ahora el zorro está calentito. ¡Su amigo el conejo viene a jugar!"
  }
