   "t": "Le renard a une grosse citrouille orange.",
   "es": "El zorro tiene una calabaza naranja grande."
  },
  {
   "img": "img/pj/gato.png",
   "also": [
    "img/season/skeleton.png"
   ],
   "t": "Son ami le chat est déguisé en squelette. Il est noir et blanc.",
   "es": "Su amigo el gato va disfrazado de esqueleto. Es negro y blanco."
  },
  {
   "img": "img/om_1F6AA.png",
   "also": [
    "img/pj/zorro.png",
    "img/pj/gato.png"
   ],
   "t": "Ils frappent à la porte du hibou. Des bonbons ou un sort !",
   "es": "Llaman a la puerta del búho. ¡Truco o trato!"
  },
  {
   "img": "img/pj/buho.png",
   "also": [
    "img/season/sweets.png"
   ],
   "t": "Le hibou ouvre la porte. Il leur donne beaucoup de bonbons.",
   "es": "El búho abre la puerta. Les da muchos caramelos."
  },
  {
   "img": "img/pj/zorro.png",
   "also": [
    "img/pj/gato.png"
   ],
   "t": "Puis ils rentrent à la maison. Il fait très sombre.",
   "es": "Luego vuelven a casa. Está muy oscuro."
  },
  {
   "img": "img/om_1F333.png",
   "also": [
    "img/om_1F47B.png"
   ],
   "t": "Oh ! Il y a un bruit derrière un arbre. Bouh !",
   "es": "¡Oh! Hay un ruido detrás de un árbol. ¡Buuu!"
  }
 ],
