   "t": "Ræven vil lege udenfor. Han tager en T-shirt på.",
   "es": "El zorro quiere jugar fuera. Se pone una camiseta."
  },
  {
   "img": "img/pj/zorro.png",
   "also": [
    "img/om_2744.png"
   ],
   "t": "Brrr! Det er for koldt til en T-shirt.",
   "es": "¡Brrr! Hace demasiado frío para una camiseta."
  },
  {
   "img": "img/pj/zorro.png",
   "also": [
    "img/om_1F9E5.png"
   ],
   "t": "Så tager han en varm frakke på.",
   "es": "Así que se pone un abrigo calentito."
  },
  {
   "img": "img/pj/zorro.png",
   "also": [
    "img/om_1F9E6.png",
    "img/om_1F462.png"
   ],
   "t": "Han tager sokker og støvler på fødderne.",
   "es": "Se pone calcetines y botas en los pies."
  },
  {
   "img": "img/pj/zorro.png",
   "also": [
    "img/om_1F9E4.png",
    "img/season/scarf.png"
   ],
   "t": "Så handsker på hænderne og et halstørklæde om halsen.",
   "es": "Luego, guantes en las manos y una bufanda alrededor del cuello."
  },
  {
   "img": "img/pj/conejo.png",
   "also": [
    "img/pj/zorro.png"
   ],
   "t": "Nu er ræven varm. Hans ven kaninen vil også lege!",
   "es": "Ahora el zorro está calentito. ¡Su amigo el conejo también quiere jugar!"
  }
 ],
