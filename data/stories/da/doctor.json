   ],
   "t": "Ræven er syg i dag. Han har ondt i hovedet.",
   "es": "El zorro está enfermo hoy. Le duele la cabeza."
  },
  {
   "img": "img/pj/oso.png",
   "also": [
    "img/om_1F9D1-200D-2695-FE0F.png"
   ],
   "t": "Han går til lægen. Lægen er en stor, venlig bjørn.",
   "es": "Va al médico. El médico es un oso grande y simpático."
  },
  {
   "img": "img/pj/oso.png",
   "also": [
    "img/om_1F444.png"
   ],
   "t": "»Åbn munden!« siger lægen.",
   "es": "«¡Abre la boca!», dice el médico."
  },
  {
   "img": "img/pj/oso.png",
   "also": [
    "img/om_1F9B7.png",
    "img/om_1F442.png"
   ],
   "t": "Lægen kigger på hans tænder og ører.",
   "es": "El médico le mira los dientes y las orejas."
  },
  {
   "img": "img/pj/zorro.png",
   "also": [
    "img/om_1F321.png",
    "img/om_1F443.png"
   ],
   "t": "Hans hoved er varmt, og hans næse er rød.",
   "es": "Tiene la cabeza caliente y la nariz roja."
  },
  {
   "img": "img/pj/oso.png",
   "also": [
    "img/om_1F48A.png"
   ],
   "t": "Lægen giver ham noget medicin.",
   "es": "El médico le da una medicina."
  },
  {
   "img": "img/pj/zorro.png",
   "also": [
    "img/om_1F6CF.png"
   ],
   "t": "Ræven går hjem. Han skal blive i sengen.",
   "es": "El zorro se va a casa. Tiene que quedarse en la cama."
  }
 ],
