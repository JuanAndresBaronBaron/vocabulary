  {
   "img": "img/pj/zorro.png",
   "also": [
    "img/om_1F455.png"
   ],
   "t": "The fox wants to play outside. He puts on a T-shirt.",
   "es": "El zorro quiere jugar fuera. Se pone una camiseta."
  },
  {
   "img": "img/pj/zorro.png",
   "also": [
    "img/om_2744.png"
   ],
   "t": "Brrr! It is too cold for a T-shirt.",
   "es": "¡Brrr! Hace demasiado frío para una camiseta."
  },
  {
   "img": "img/pj/zorro.png",
   "also": [
    "img/om_1F9E5.png"
   ],
   "t": "So he puts on a warm coat.",
   "es": "Así que se pone un abrigo calentito."
  },
  {
   "img": "img/pj/zorro.png",
   "also": [
    "img/om_1F9E6.png",
    "img/om_1F462.png"
   ],
   "t": "He puts socks and boots on his feet.",
   "es": "Se pone calcetines y botas en los pies."
  },
  {
