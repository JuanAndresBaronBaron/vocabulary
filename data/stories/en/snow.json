   "also": [
    "img/om_1F9E4.png",
    "img/season/scarf.png"
   ],
   "t": "Then gloves on his hands and a scarf around his neck.",
   "es": "Luego, guantes en las manos y una bufanda alrededor del cuello."
  },
  {
   "img": "img/pj/conejo.png",
   "also": [
    "img/pj/zorro.png"
   ],
   "t": "Now the fox is warm. His friend the rabbit comes to play!",
   "es": "Ahora el zorro está calentito. ¡Su amigo el conejo viene a jugar!"
  }
 ],
