{"id": "w38", "num": 38, "title": "Adverbios (1)", "rows": [{"cat": "NIVEL A1 · PRINCIPIANTE"}, {"es": "otra vez, de nuevo", "img": "img/om_1F501.png", "level": "A1", "pos": "adverb", "l": {"english": {"word": "again", "forms": "", "pron": "egén", "ipa": "/əˈɡen/", "ex": "Can you say that again, please?", "ex_es": "¿Puedes repetirlo, por favor?"}, "français": {"word": "encore", "forms": "", "pron": "ankór", "ipa": "/ɑ̃kɔʁ/", "ex": "Tu peux répéter encore une fois ?", "ex_es": "¿Puedes repetirlo otra vez?"}, "dansk": {"word": "igen", "forms": "", "pron": "igén", "ipa": "/iˈgɛn/", "ex": "Kan du sige det igen, tak?", "ex_es": "¿Puedes decirlo otra vez, por favor?"}}}, {"es": "hace (tiempo)", "img": null, "level": "A1", "pos": "adverb", "l": {"english": {"word": "ago", "forms": "", "pron": "egóu", "ipa": "/əˈɡəʊ/", "ex": "I met him two years ago.", "ex_es": "Lo conocí hace dos años."}, "français": {"word": "il y a", "forms": "", "pron": "il i á", "ipa": "/il i a/", "ex": "Je suis arrivé il y a deux jours.", "ex_es": "Llegué hace dos días."}, "dansk": {"word": "for … siden", "forms": "", "pron": "for … síden", "ipa": "/fʌ … ˈsiðən/", "ex": "Jeg kom til Danmark for to år siden.", "ex_es": "Llegué a Dinamarca hace dos años."}}}, {"es": "también", "img": null, "level": "A1", "pos": "adverb", "l": {"english": {"word": "also", "forms": "", "pron": "óolsou", "ipa": "/ˈɔːlsəʊ/", "ex": "She speaks French and also German.", "ex_es": "Habla francés y también alemán."}, "français": {"word": "aussi", "forms": "", "pron": "osí", "ipa": "/osi/", "ex": "Moi aussi, j'aime le chocolat.", "ex_es": "A mí también me gusta el chocolate."}, "dansk": {"word": "også", "forms": "", "pron": "óse", "ipa": "/ˈʌsə/", "ex": "Jeg taler også lidt dansk.", "ex_es": "También hablo un poco de danés."}}}, {"es": "siempre", "img": null, "level": "A1", "pos": "adverb", "l": {"english": {"word": "always", "forms": "", "pron": "óolueiz", "ipa": "/ˈɔːlweɪz/", "ex": "I always have tea for breakfast.", "ex_es": "Siempre tomo té en el desayuno."}, "français": {"word": "toujours", "forms": "", "pron": "tujúr", "ipa": "/tuʒuʁ/", "ex": "Il arrive toujours à l'heure.", "ex_es": "Siempre llega a la hora."}, "dansk": {"word": "altid", "forms": "", "pron": "áltid", "ipa": "/ˈaltið/", "ex": "Hun drikker altid kaffe om morgenen.", "ex_es": "Ella siempre toma café por la mañana."}}}, {"es": "lejos, fuera", "img": null, "level": "A1", "pos": "adverb", "l": {"english": {"word": "away", "forms": "", "pron": "euéi", "ipa": "/əˈweɪ/", "ex": "Go away and leave me alone!", "ex_es": "¡Vete y déjame en paz!"}, "français": {"word": "loin", "forms": "", "pron": "luán", "ipa": "/lwɛ̃/", "ex": "Il est parti loin de sa famille.", "ex_es": "Se fue lejos de su familia."}, "dansk": {"word": "væk", "forms": "", "pron": "vek", "ipa": "/ˈvɛg/", "ex": "Gå væk fra vejen, der kommer en bil!", "ex_es": "¡Apártate de la carretera, viene un coche!"}}}, {"es": "abajo", "img": "img/om_2B07.png", "level": "A1", "pos": "adverb", "l": {"english": {"word": "down", "forms": "", "pron": "dáun", "ipa": "/daʊn/", "ex": "Please sit down and relax.", "ex_es": "Por favor, siéntate y relájate."}, "français": {"word": "en bas", "forms": "", "pron": "an bá", "ipa": "/ɑ̃ ba/", "ex": "Ne regarde pas en bas, c'est haut !", "ex_es": "No mires abajo, ¡está alto!"}, "dansk": {"word": "ned", "forms": "", "pron": "ned", "ipa": "/ˈneð/", "ex": "Hun gik ned ad trappen.", "ex_es": "Ella bajó por la escalera."}}}, {"es": "abajo (en el piso de abajo)", "img": null, "level": "A1", "pos": "adverb", "l": {"english": {"word": "downstairs", "forms": "", "pron": "daunstéez", "ipa": "/ˌdaʊnˈsteəz/", "ex": "The kitchen is downstairs.", "ex_es": "La cocina está abajo."}, "français": {"word": "en bas", "forms": "", "pron": "an bá", "ipa": "/ɑ̃ ba/", "ex": "La cuisine est en bas, au rez-de-chaussée.", "ex_es": "La cocina está abajo, en la planta baja."}, "dansk": {"word": "nedenunder", "forms": "", "pron": "nédenoner", "ipa": "/ˈneːðənˌɔnɐ/", "ex": "Køkkenet ligger nedenunder i huset.", "ex_es": "La cocina está en el piso de abajo."}}}, {"es": "más, otro", "img": null, "level": "A1", "pos": "adverb", "l": {"english": {"word": "else", "forms": "", "pron": "els", "ipa": "/els/", "ex": "Would you like anything else?", "ex_es": "¿Desea algo más?"}, "français": {"word": "d'autre", "forms": "", "pron": "dótr", "ipa": "/dotʁ/", "ex": "Tu veux quelque chose d'autre ?", "ex_es": "¿Quieres algo más?"}, "dansk": {"word": "ellers", "forms": "", "pron": "élers", "ipa": "/ˈɛlɐs/", "ex": "Hvad vil du ellers have at spise?", "ex_es": "¿Qué más quieres comer?"}}}, {"es": "incluso", "img": null, "level": "A1", "pos": "adverb", "l": {"english": {"word": "even", "forms": "", "pron": "íiven", "ipa": "/ˈiːvn/", "ex": "Even my grandmother uses the internet.", "ex_es": "Incluso mi abuela usa internet."}, "français": {"word": "même", "forms": "", "pron": "mem", "ipa": "/mɛm/", "ex": "Même mon père aime cette chanson.", "ex_es": "Incluso a mi padre le gusta esta canción."}, "dansk": {"word": "endda", "forms": "", "pron": "énda", "ipa": "/ˈɛnda/", "ex": "Det var endda bedre end sidste år.", "ex_es": "Fue incluso mejor que el año pasado."}}}, {"es": "alguna vez", "img": null, "level": "A1", "pos": "adverb", "l": {"english": {"word": "ever", "forms": "", "pron": "éve", "ipa": "/ˈevə/", "ex": "Have you ever been to Scotland?", "ex_es": "¿Has estado alguna vez en Escocia?"}, "français": {"word": "déjà", "forms": "", "pron": "dejá", "ipa": "/deʒa/", "ex": "Tu es déjà allé à Paris ?", "ex_es": "¿Has estado alguna vez en París?"}, "dansk": {"word": "nogensinde", "forms": "", "pron": "nóensine", "ipa": "/ˈnoːənˌsenə/", "ex": "Har du nogensinde været i Spanien?", "ex_es": "¿Has estado alguna vez en España?"}}}, {"es": "lejos", "img": null, "level": "A1", "pos": "adverb", "l": {"english": {"word": "far", "forms": "further", "pron": "faa", "ipa": "/fɑː/", "ex": "Is the station far from here?", "ex_es": "¿Está lejos la estación de aquí?"}, "français": {"word": "loin", "forms": "", "pron": "luán", "ipa": "/lwɛ̃/", "ex": "La gare est loin d'ici ?", "ex_es": "¿La estación está lejos de aquí?"}, "dansk": {"word": "langt", "forms": "længere, længst", "pron": "lángt", "ipa": "/ˈlaŋˀd/", "ex": "Bor du langt fra skolen?", "ex_es": "¿Vives lejos del colegio?"}}}, {"es": "aquí", "img": null, "level": "A1", "pos": "adverb", "l": {"english": {"word": "here", "forms": "", "pron": "jíe", "ipa": "/hɪə/", "ex": "Come here and sit with me.", "ex_es": "Ven aquí y siéntate conmigo."}, "français": {"word": "ici", "forms": "", "pron": "isí", "ipa": "/isi/", "ex": "Viens ici, s'il te plaît.", "ex_es": "Ven aquí, por favor."}, "dansk": {"word": "her", "forms": "", "pron": "jer", "ipa": "/ˈhɛɐ̯ˀ/", "ex": "Jeg har boet her i fem år.", "ex_es": "Llevo cinco años viviendo aquí."}}}, {"es": "solo, justo, acabar de", "img": null, "level": "A1", "pos": "adverb", "l": {"english": {"word": "just", "forms": "", "pron": "yast", "ipa": "/dʒʌst/", "ex": "I've just finished my homework.", "ex_es": "Acabo de terminar los deberes."}, "français": {"word": "juste", "forms": "", "pron": "jüst", "ipa": "/ʒyst/", "ex": "Je veux juste un café.", "ex_es": "Solo quiero un café."}, "dansk": {"word": "lige", "forms": "", "pron": "líe", "ipa": "/ˈliːə/", "ex": "Jeg er lige kommet hjem.", "ex_es": "Acabo de llegar a casa."}}}, {"es": "más tarde, luego", "img": null, "level": "A1", "pos": "adverb", "l": {"english": {"word": "later", "forms": "", "pron": "léite", "ipa": "/ˈleɪtə/", "ex": "I'll call you back later.", "ex_es": "Te llamo luego."}, "français": {"word": "plus tard", "forms": "", "pron": "plü tár", "ipa": "/ply taʁ/", "ex": "On se voit plus tard ?", "ex_es": "¿Nos vemos más tarde?"}, "dansk": {"word": "senere", "forms": "", "pron": "sénere", "ipa": "/ˈseːnɐɐ/", "ex": "Vi ses senere i dag!", "ex_es": "¡Nos vemos luego hoy!"}}}, {"es": "quizás, tal vez", "img": null, "level": "A1", "pos": "adverb", "l": {"english": {"word": "maybe", "forms": "", "pron": "méibi", "ipa": "/ˈmeɪbi/", "ex": "Maybe we can meet tomorrow.", "ex_es": "Quizás podamos quedar mañana."}, "français": {"word": "peut-être", "forms": "", "pron": "pötétr", "ipa": "/pøtɛtʁ/", "ex": "Il va peut-être pleuvoir demain.", "ex_es": "Quizás llueva mañana."}, "dansk": {"word": "måske", "forms": "", "pron": "moské", "ipa": "/mɔˈsgeˀ/", "ex": "Måske regner det i morgen.", "ex_es": "Quizás llueva mañana."}}}, {"es": "nunca", "img": null, "level": "A1", "pos": "adverb", "l": {"english": {"word": "never", "forms": "", "pron": "néve", "ipa": "/ˈnevə/", "ex": "I've never seen the sea.", "ex_es": "Nunca he visto el mar."}, "français": {"word": "jamais", "forms": "", "pron": "jamé", "ipa": "/ʒamɛ/", "ex": "Je ne bois jamais de café.", "ex_es": "Nunca bebo café."}, "dansk": {"word": "aldrig", "forms": "", "pron": "áldri", "ipa": "/ˈaldʁi/", "ex": "Jeg har aldrig været i Rom.", "ex_es": "Nunca he estado en Roma."}}}, {"es": "no", "img": null, "level": "A1", "pos": "adverb", "l": {"english": {"word": "not", "forms": "", "pron": "not", "ipa": "/nɒt/", "ex": "I'm not hungry, thanks.", "ex_es": "No tengo hambre, gracias."}, "français": {"word": "ne… pas", "forms": "", "pron": "ne pá", "ipa": "/nə pa/", "ex": "Je ne parle pas allemand.", "ex_es": "No hablo alemán."}, "dansk": {"word": "ikke", "forms": "", "pron": "íke", "ipa": "/ˈegə/", "ex": "Jeg forstår ikke spørgsmålet.", "ex_es": "No entiendo la pregunta."}}}, {"es": "ahora", "img": null, "level": "A1", "pos": "adverb", "l": {"english": {"word": "now", "forms": "", "pron": "náu", "ipa": "/naʊ/", "ex": "I'm busy now, call me later.", "ex_es": "Ahora estoy ocupado, llámame luego."}, "français": {"word": "maintenant", "forms": "", "pron": "mantenán", "ipa": "/mɛ̃tnɑ̃/", "ex": "Je dois partir maintenant.", "ex_es": "Tengo que irme ahora."}, "dansk": {"word": "nu", "forms": "", "pron": "nu", "ipa": "/ˈnu/", "ex": "Jeg har ikke tid lige nu.", "ex_es": "Ahora mismo no tengo tiempo."}}}, {"es": "a menudo", "img": null, "leve