, "l": {"english": {"word": "rather", "forms": "", "pron": "ráade", "ipa": "/ˈrɑːðə/", "ex": "It's rather cold today.", "ex_es": "Hoy hace bastante frío."}, "français": {"word": "plutôt", "forms": "", "pron": "plütó", "ipa": "/plyto/", "ex": "Il fait plutôt froid ce matin.", "ex_es": "Hace bastante frío esta mañana."}, "dansk": {"word": "temmelig", "forms": "", "pron": "témeli", "ipa": "/ˈtɛməli/", "ex": "Det er temmelig koldt i dag.", "ex_es": "Hoy hace bastante frío."}}}, {"es": "recientemente", "img": null, "level": "A2", "pos": "adverb", "l": {"english": {"word": "recently", "forms": "", "pron": "ríisentli", "ipa": "/ˈriːsntli/", "ex": "Have you seen any good films recently?", "ex_es": "¿Has visto alguna buena película recientemente?"}, "français": {"word": "récemment", "forms": "", "pron": "resamán", "ipa": "/ʁesamɑ̃/", "ex": "Ils ont récemment déménagé à Lyon.", "ex_es": "Se han mudado recientemente a Lyon."}, "dansk": {"word": "for nylig", "forms": "", "pron": "for nüli", "ipa": "/fʌ ˈnyːli/", "ex": "Jeg flyttede til København for nylig.", "ex_es": "Me mudé a Copenhague recientemente."}}}, {"es": "tristemente", "img": null, "level": "A2", "pos": "adverb", "l": {"english": {"word": "sadly", "forms": "", "pron": "sádli", "ipa": "/ˈsædli/", "ex": "Sadly, our dog died last year.", "ex_es": "Tristemente, nuestro perro murió el año pasado."}, "français": {"word": "tristement", "forms": "", "pron": "tristemán", "ipa": "/tʁistəmɑ̃/", "ex": "Elle a regardé tristement par la fenêtre.", "ex_es": "Miró tristemente por la ventana."}, "dansk": {"word": "trist", "forms": "", "pron": "trist", "ipa": "/ˈtʁisd/", "ex": "Hun smilede trist til mig.", "ex_es": "Ella me sonrió tristemente."}}}, {"es": "despacio", "img": "img/om_1F40C.png", "level": "A2", "pos": "adverb", "l": {"english": {"word": "slowly", "forms": "more slowly", "pron": "slóuli", "ipa": "/ˈsləʊli/", "ex": "Could you speak more slowly, please?", "ex_es": "¿Podrías hablar más despacio, por favor?"}, "français": {"w