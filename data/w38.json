ía, ya", "img": null, "level": "A2", "pos": "adverb", "l": {"français": {"word": "pas encore", "forms": "", "pron": "pa ankór", "ipa": "/pa ɑ̃kɔʁ/", "ex": "Je n'ai pas encore mangé.", "ex_es": "Todavía no he comido."}}}]}