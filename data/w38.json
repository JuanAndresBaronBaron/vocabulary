k": {"word": "pludselig", "forms": "", "pron": "plúseli", "ipa": "/ˈplusəli/", "ex": "Pludselig begyndte det at regne.", "ex_es": "De repente empezó a llover."}}}, {"es": "desafortunadamente", "img": null, "level": "A2", "pos": "adverb", "l": {"english": {"word": "unfortunately", "forms": "", "pron": "anfóochenetli", "ipa": "/ʌnˈfɔːtʃənətli/", "ex": "Unfortunately, the shop was closed.", "ex_es": "Desafortunadamente, la tienda estaba cerrada."}, "français": {"word": "malheureusement", "forms": "", "pron": "malörösmán", "ipa": "/maløʁøzmɑ̃/", "ex": "Malheureusement, je ne peux pas venir.", "ex_es": "Desafortunadamente, no puedo ir."}, "dansk": {"word": "desværre", "forms": "", "pron": "desvére", "ipa": "/dɛsˈvɛɐ̯ɐ/", "ex": "Desværre kan jeg ikke komme i aften.", "ex_es": "Desafortunadamente no puedo ir esta noche."}}}, {"es": "todavía, ya", "img": null, "level": "A2", "pos": "adverb", "l": {"english": {"word": "yet", "forms": "", "pron": "iet", "ipa": "/jet/", "ex": "Have you finished your homework yet?", "ex_es": "¿Ya has terminado los deberes?"}, "français": {"word": "pas encore", "forms": "", "pron": "pa ankór", "ipa": "/pa ɑ̃kɔʁ/", "ex": "Je n'ai pas encore mangé.", "ex_es": "Todavía no he comido."}, "dansk": {"word": "endnu", "forms": "", "pron": "énu", "ipa": "/ˈenu/", "ex": "Jeg har ikke spist endnu.", "ex_es": "Todavía no he comido."}}}]}