": "Je ne parle pas allemand.", "ex_es": "No hablo alemán."}}}, {"es": "ahora", "img": null, "level": "A1", "pos": "adverb", "l": {"français": {"word": "maintenant", "forms": "", "pron": "mantenán", "ipa": "/mɛ̃tnɑ̃/", "ex": "Je dois partir maintenant.", "ex_es": "Tengo que irme ahora."}}}, {"es": "a menudo", "img": null, "level": "A1", "pos": "adverb", "l": {"français": {"word": "souvent", "forms": "", "pron": "suván", "ipa": "/suvɑ̃/", "ex": "Nous allons souvent au cinéma.", "ex_es": "Vamos a menudo al cine."}}}, {"es": "una vez", "img": null, "level": "A1", "pos": "adverb", "l": {"français": {"word": "une fois", "forms": "", "pron": "ün fuá", "ipa": "/yn fwa/", "ex": "Je vais à la piscine une fois par semaine.", "ex_es": "Voy a la piscina una vez por semana."}}}, {"es": "solo, solamente", "img": null, "level": "A1", "pos": "adverb", "l": {"français": {"word": "seulement", "forms": "", "pron": "sölmán", "ipa": "/sœlmɑ̃/", "ex": "J'ai seulement dix euros sur moi.", "ex_es": "Solo llevo diez euros encima."}}}, {"es": "fuera", "img": null, "level": "A1", "pos": "adverb", "l": {"français": {"word": "dehors", "forms": "", "pron": "deór", "ipa": "/dəɔʁ/", "ex": "Les enfants jouent dehors.", "ex_es": "Los niños juegan fuera."}}}, {"es": "probablemente", "img": null, "level": "A1", "pos": "adverb", "l": {"français": {"word": "probablement", "forms": "", "pron": "probablemán", "ipa": "/pʁɔbabləmɑ̃/", "ex": "Il va probablement arriver en retard.", "ex_es": "Probablemente llegará tarde."}}}, {"es": "rápidamente", "img": null, "level": "A1", "pos": "adverb", "l": {"français": {"word": "vite", "forms": "", "pron": "vit", "ipa": "/vit/", "ex": "Viens vite, le bus arrive !", "ex_es": "¡Ven rápido, que llega el autobús!"}}}, {"es": "bastante", "img": null, "level": "A1", "pos": "adverb", "l": {"français": {"word": "assez", "forms": "", "pron": "asé", "ipa": "/ase/", "ex": "Le film était assez intéressant.", "ex_es": "La película era bastante interesante."}}}, {"es": "realmente, muy", "img": null, "level": "A1", "pos": "adverb", "l": {"français": {"word": "vraiment", "forms": "", "pron": "vremán", "ipa": "/vʁɛmɑ̃/", "ex": "Ce gâteau est vraiment délicieux.", "ex_es": "Esta tarta está realmente deliciosa."}}}, {"es": "a veces", "img": null, "level": "A1", "pos": "adverb", "l": {"français": {"word": "parfois", "forms": "", "pron": "parfuá", "ipa": "/paʁfwa/", "ex": "Parfois, je vais au travail à pied.", "ex_es": "A veces voy al trabajo a pie."}}}, {"es": "pronto", "img": "img/om_1F51C.png", "level": "A1", "pos": "adverb", "l": {"français": {"word": "bientôt", "forms": "", "pron": "biantó", "ipa": "/bjɛ̃to/", "ex": "Les vacances arrivent bientôt.", "ex_es": "Las vacaciones llegan pronto."}}}, {"es": "todavía, aún", "img": null, "level": "A1", "pos": "adverb", "l": {"français": {"word": "encore", "forms": "", "pron": "ankór", "ipa": "/ɑ̃kɔʁ/", "ex": "Il est encore au bureau.", "ex_es": "Todavía está en la oficina."}}}, {"es": "entonces, luego", "img": null, "level": "A1", "pos": "adverb", "l": {"français": {"word": "ensuite", "forms": "", "pron": "ansüít", "ipa": "/ɑ̃sɥit/", "ex": "Je me lave, ensuite je m'habille.", "ex_es": "Me lavo y luego me visto."}}}, {"es": "allí, ahí", "img": null, "level": "A1", "pos": "adverb", "l": {"français": {"word": "là", "forms": "", "pron": "la", "ipa": "/la/", "ex": "Pose ton sac là, sur la chaise.", "ex_es": "Deja tu bolso ahí, en la silla."}}}, {"es": "juntos", "img": "img/om_1F9D1-200D-1F91D-200D-1F9D1.png", "level": "A1", "pos": "adverb", "l": {"français": {"word": "ensemble", "forms": "", "pron": "ansánbl", "ipa": "/ɑ̃sɑ̃bl/", "ex": "Nous dînons ensemble ce soir.", "ex_es": "Cenamos juntos esta noche."}}}, {"es": "también, demasiado", "img": null, "level": "A1", "pos": "adverb", "l": {"français": {"word": "trop", "forms": "", "pron": "tro", "ipa": "/tʁo/", "ex": "Ce café est trop chaud.", "ex_es": "Este café está demasiado caliente."}}}, {"es": "dos veces", "img": null, "level": "A1", "pos": "adverb", "l":